<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Projects | Portfolio</title>
  <style>
    /* Base Styles */
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --text-color: #f8fafc;
      --text-muted: #94a3b8;
      --accent-color: #38bdf8;
      --border-radius: 12px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      line-height: 1.6;
      padding: 2rem 1rem;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
    }

    h1 {
      font-size: 2.5rem;
      margin-bottom: 2rem;
      text-align: center;
      color: var(--text-color);
    }

    /* Projects List Container */
    .projects-list {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    /* Individual Project Card */
    .project-card {
      display: flex;
      flex-direction: row;
      background-color: var(--card-bg);
      border-radius: var(--border-radius);
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .project-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
    }

    /* Image on Left */
    .project-image {
      flex: 0 0 40%;
      min-height: 220px;
    }

    .project-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Content on Right */
    .project-content {
      flex: 1;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .project-title {
      font-size: 1.5rem;
      margin-bottom: 0.75rem;
      color: var(--text-color);
    }

    .project-description {
      color: var(--text-muted);
      font-size: 1rem;
      margin-bottom: 1.25rem;
    }

    /* Action Links/Tags */
    .project-links {
      display: flex;
      gap: 1rem;
    }

    .project-links a {
      color: var(--accent-color);
      text-decoration: none;
      font-weight: 600;
      font-size: 0.95rem;
    }

    .project-links a:hover {
      text-decoration: underline;
    }

    /* Mobile Responsiveness */
    @media (max-width: 768px) {
      .project-card {
        flex-direction: column;
      }

      .project-image {
        min-height: 200px;
      }
    }
  </style>
</head>
<body>

  <main class="container">
    <h1>Featured Projects</h1>

    <div class="projects-list">

      <!-- Project 1 -->
      <article class="project-card">
        <div class="project-image">
          <img src="https://via.placeholder.com/600x400" alt="Project 1 Preview">
        </div>
        <div class="project-content">
          <h2 class="project-title">Project Title One</h2>
          <p class="project-description">
            A concise description of your first project. Explain what problem it solves, the tools or technologies used, and your primary role in bringing it to completion.
          </p>
          <div class="project-links">
            <a href="#" target="_blank" rel="noopener">View Live Site &rarr;</a>
            <a href="#" target="_blank" rel="noopener">GitHub Repo &rarr;</a>
          </div>
        </div>
      </article>

      <!-- Project 2 -->
      <article class="project-card">
        <div class="project-image">
          <img src="https://via.placeholder.com/600x400" alt="Project 2 Preview">
        </div>
        <div class="project-content">
          <h2 class="project-title">Project Title Two</h2>
          <p class="project-description">
            A concise description of your second project. Detail key functionality, workflow integrations, or data processing pipelines implemented during development.
          </p>
          <div class="project-links">
            <a href="#" target="_blank" rel="noopener">View Live Site &rarr;</a>
            <a href="#" target="_blank" rel="noopener">GitHub Repo &rarr;</a>
          </div>
        </div>
      </article>

      <!-- Project 3 -->
      <article class="project-card">
        <div class="project-image">
          <img src="https://via.placeholder.com/600x400" alt="Project 3 Preview">
        </div>
        <div class="project-content">
          <h2 class="project-title">Project Title Three</h2>
          <p class="project-description">
            A concise description of your third project. Highlight any notable tech stacks, unique visual outputs, or key performance metrics achieved.
          </p>
          <div class="project-links">
            <a href="#" target="_blank" rel="noopener">View Live Site &rarr;</a>
            <a href="#" target="_blank" rel="noopener">GitHub Repo &rarr;</a>
          </div>
        </div>
      </article>

    </div>
  </main>

</body>
</html>
